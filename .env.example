# Copy to .env on the server (never commit .env).

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → install command)
TUNNEL_TOKEN=

# Cloudflare Access — backend verifies the Access JWT when both are set
# Team domain: Zero Trust → Settings → Custom pages / team name, e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag: Zero Trust → Access → Applications → your app → Overview
CF_ACCESS_AUD=

# Backups (scripts/backup.sh) — restic to Backblaze B2
RESTIC_REPOSITORY=b2:your-bucket-name:face-lapse
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# healthchecks.io ping URL (optional, emails you when a nightly backup is missed)
HEALTHCHECK_URL=
