# Copy to .env on the server (never commit .env).

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → install command)
TUNNEL_TOKEN=

# Cloudflare Access — backend verifies the Access JWT when both are set
# Team domain: Zero Trust → Settings → Custom pages / team name, e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag: Zero Trust → Access → Applications → your app → Overview
CF_ACCESS_AUD=

# Backups (scripts/backup.sh) — restic to Backblaze B2
RESTIC_REPOSITORY=b2:your-bucket-name:face-lapse
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# healthchecks.io ping URL (optional, emails you when a nightly backup is missed)
HEALTHCHECK_URL=
# healthchecks.io ping URL for a second check, "face-lapse-storage" (optional). The nightly backup
# pings it while storage is fine and pings <URL>/fail when a limit below is reached.
STORAGE_HEALTHCHECK_URL=
# Alert when the B2 repository reaches this many bytes (default 8000000000 = 80% of the 10 GB free tier)
# STORAGE_ALERT_REPO_BYTES=8000000000
# Alert when the server disk is this percent full (default 80). The app uses the same two values to
# show a warning in Archive health.
# STORAGE_ALERT_DISK_PCT=80

# Exported videos (data/videos/*.mp4) are deleted after this many days; 0 keeps them forever (default 7)
# VIDEO_RETENTION_DAYS=7
